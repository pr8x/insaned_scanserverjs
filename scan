#!/bin/bash

# Build params object with only set values
params='{"deviceId":"'"$SCANSERVJS_DEVICE_ID"'"'

[ -n "$SCANSERVJS_RESOLUTION" ] && params+=",\"resolution\":$SCANSERVJS_RESOLUTION"
[ -n "$SCANSERVJS_WIDTH" ] && params+=",\"width\":$SCANSERVJS_WIDTH"
[ -n "$SCANSERVJS_HEIGHT" ] && params+=",\"height\":$SCANSERVJS_HEIGHT"
[ -n "$SCANSERVJS_LEFT" ] && params+=",\"left\":$SCANSERVJS_LEFT"
[ -n "$SCANSERVJS_TOP" ] && params+=",\"top\":$SCANSERVJS_TOP"
[ -n "$SCANSERVJS_PAGE_HEIGHT" ] && params+=",\"pageHeight\":$SCANSERVJS_PAGE_HEIGHT"
[ -n "$SCANSERVJS_PAGE_WIDTH" ] && params+=",\"pageWidth\":$SCANSERVJS_PAGE_WIDTH"
[ -n "$SCANSERVJS_MODE" ] && params+=",\"mode\":\"$SCANSERVJS_MODE\""
[ -n "$SCANSERVJS_SOURCE" ] && params+=",\"source\":\"$SCANSERVJS_SOURCE\""
[ -n "$SCANSERVJS_BRIGHTNESS" ] && params+=",\"brightness\":$SCANSERVJS_BRIGHTNESS"
[ -n "$SCANSERVJS_CONTRAST" ] && params+=",\"contrast\":$SCANSERVJS_CONTRAST"

params+="}"

# Build top-level optional fields
extra=""
[ -n "$SCANSERVJS_BATCH" ] && extra+=",\"batch\":\"$SCANSERVJS_BATCH\""
[ -n "$SCANSERVJS_INDEX" ] && extra+=",\"index\":$SCANSERVJS_INDEX"

payload="{\"params\":${params},\"filters\":[],\"pipeline\":\"${SCANSERVJS_PIPELINE}\"${extra}}"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Scan payload: $payload"

# Execute the scan request
curl -s "$SCAN_URL" \
  -H 'Content-Type: application/json' \
  --compressed \
  --insecure \
  --max-time 30 \
  --data-raw "$payload"